# -----------------------------------------
# 6. PAIRWISE COMPARISON METHOD
# -----------------------------------------

def pairwise_merge(contacts):

    groups = []

    for contact in contacts:

        phone = normalise_phone(contact.get("phone", ""))

        if not phone:
            continue

        found = False

        for group in groups:

            if phone in group["numbers"]:
                found = True

                if contact.get("email"):
                    group["emails"].add(
                        normalise_email(contact["email"])
                    )

                break

        if not found:

            groups.append({
                "numbers": {phone},
                "emails": {
                    normalise_email(contact["email"])
                } if contact.get("email") else set()
            })

    return groups


# -----------------------------------------
# 7. GENERATE TEST DATA
# -----------------------------------------

def generate_contacts(n):

    data = []

    for i in range(n):

        number = str(9000000000 + (i % (n // 2 + 1)))

        contact = {
            "name": "Person" + str(i),
            "phone": number,
            "email": "person" + str(i) + "@gmail.com"
        }

        data.append(contact)

    return data



# -----------------------------------------
# 1. NORMALISE PHONE NUMBERS
# -----------------------------------------

def normalise_phone(phone):
    if not phone:
        return ""

    digits = ""

    for ch in str(phone):
        if ch.isdigit():
            digits += ch

    # Convert Indian numbers to a standard 10-digit format
    if len(digits) == 12 and digits.startswith("91"):
        digits = digits[2:]

    if len(digits) == 11 and digits.startswith("0"):
        digits = digits[1:]

    return digits


# -----------------------------------------
# 2. NORMALISE NAMES AND EMAILS
# -----------------------------------------

def normalise_name(name):
    if not name:
        return ""

    return " ".join(name.lower().strip().split())


def normalise_email(email):
    if not email:
        return ""

    return email.lower().strip()


# -----------------------------------------
# 3. CONTACT MERGING USING DICTIONARY
# -----------------------------------------

def merge_contacts(contacts):

    merged = {}

    for contact in contacts:

        name = contact.get("name", "").strip()
        phone = normalise_phone(contact.get("phone", ""))
        email = normalise_email(contact.get("email", ""))

        # Use phone number as the primary identity.
        # Use email as a fallback when phone is missing.
        if phone:
            key = "PHONE:" + phone
        elif email:
            key = "EMAIL:" + email
        else:
            # Cannot safely identify a contact without phone or email
            key = "UNMATCHED:" + str(id(contact))

        if key not in merged:
            merged[key] = {
                "name": name,
                "numbers": set(),
                "emails": set()
            }

        if name and not merged[key]["name"]:
            merged[key]["name"] = name

        if phone:
            merged[key]["numbers"].add(phone)

        if email:
            merged[key]["emails"].add(email)

    return list(merged.values())


# -----------------------------------------
# 4. DISPLAY MERGED CONTACTS
# -----------------------------------------

def display_contacts(contacts):

    print("\nMERGED CONTACT LIST")
    print("=" * 50)

    for i, contact in enumerate(contacts, 1):

        print("\nContact", i)
        print("Name:", contact["name"] or "Unknown")
        print("Phone numbers:", sorted(contact["numbers"]))
        print("Emails:", sorted(contact["emails"]))


